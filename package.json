{
  "name": "copilot-usage-extension",
  "displayName": "Copilot Credits",
  "description": "Your Copilot credit use in the status bar: today, this month, the monthly pace and your top models, read from Copilot Chat's local logs.",
  "version": "0.1.0",
  "publisher": "leonbjorklund",
  "license": "MIT",
  "scripts": {
    "compile": "tsc && node esbuild.js",
    "prepreview": "npm test",
    "preview": "npm run compile && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preview.ps1",
    "vscode:prepublish": "npm test && tsc && node esbuild.js --production",
    "test": "vitest run --dir test",
    "package": "vsce package --no-dependencies",
    "install:local": "node scripts/install-local.js"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leonbjorklund/copilot-usage-extension.git"
  },
  "bugs": {
    "url": "https://github.com/leonbjorklund/copilot-usage-extension/issues"
  },
  "keywords": [
    "copilot",
    "credits",
    "quota",
    "usage",
    "ai"
  ],
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "logos/logo.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "logos/logo.png",
    "LICENSE"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
