{
  "name": "copilot-usage-extension",
  "displayName": "Copilot Credits",
  "description": "Your Copilot credit use in the status bar, read from Copilot Chat's local log.",
  "version": "0.0.6",
  "publisher": "leonbjorklund",
  "license": "MIT",
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true});\"",
    "check-types": "tsc --noEmit -p ./",
    "compile": "npm run check-types && node esbuild.js",
    "prepreview": "npm test",
    "preview": "npm run compile && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preview.ps1",
    "compile:production": "npm run check-types && node esbuild.js --production",
    "vscode:prepublish": "npm test && npm run compile:production",
    "watch": "node esbuild.js --watch",
    "test": "vitest run --dir test --passWithNoTests",
    "package": "vsce package --no-dependencies",
    "install:local": "node scripts/install-local.js"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/leonbjorklund/copilot-usage-extension.git"
  },
  "bugs": {
    "url": "https://github.com/leonbjorklund/copilot-usage-extension/issues"
  },
  "homepage": "https://github.com/leonbjorklund/copilot-usage-extension#readme",
  "keywords": [
    "copilot",
    "credits",
    "quota",
    "usage",
    "ai"
  ],
  "pricing": "Free",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "logos/logo.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
